%============================================================================
%  1. REGISTRE DES COULEURS  --  MODIFIEZ UNIQUEMENT LES CODES HEXA ICI
%============================================================================
% --- Structure du document ---
\definecolor{mcChapitre}{HTML}{{{color.chapter}}}  % Titre de chapitre (cadre)
\definecolor{mcPartie}{HTML}{{{color.part}}}  % I - Grande partie
\definecolor{mcSousPartie}{HTML}{{{color.subpart}}}  % 1 - Sous-partie
\definecolor{mcParagraphe}{HTML}{{{color.paragraph}}}  % a) Paragraphe

% --- Environnements de cours ---
\definecolor{mcDef}{HTML}{{{color.definition}}}  % Definition
\definecolor{mcProp}{HTML}{{{color.property}}}  % Propriete
\definecolor{mcTheo}{HTML}{{{color.theorem}}}  % Theoreme
\definecolor{mcMethode}{HTML}{{{color.method}}}  % Methode
\definecolor{mcExemple}{HTML}{{{color.example}}}  % Exemple
\definecolor{mcApp}{HTML}{{{color.application}}}  % Application
\definecolor{mcRemarque}{HTML}{{{color.remark}}}  % Remarque
\definecolor{mcDemo}{HTML}{{{color.proof}}}  % Demonstration

% --- Divers ---
\definecolor{mcTexte}{HTML}{{{color.body}}}  % Corps de texte

%============================================================================
%  2. REGLAGES GLOBAUX
%============================================================================
\color{mcTexte}
\setlength{\parindent}{0pt}
\setlength{\parskip}{0.45\baselineskip}
