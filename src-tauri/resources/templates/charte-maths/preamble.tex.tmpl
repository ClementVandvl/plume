% Raccourcis mathematiques usuels
\newcommand{\R}{\mathbb{R}}  \newcommand{\N}{\mathbb{N}}
\newcommand{\Z}{\mathbb{Z}}  \newcommand{\Q}{\mathbb{Q}}
\newcommand{\C}{\mathbb{C}}  \newcommand{\droite}[1]{(#1)}

%============================================================================
%  3. SOULIGNEMENT COLORE  \mcul{couleur}{texte}
%============================================================================
\newcommand{\mcul}[2]{%
  \leavevmode\begingroup
  \sbox0{\color{#1}#2}%
  \usebox0%
  \kern-\wd0%
  \textcolor{#1}{\rule[-0.45ex]{\wd0}{0.6pt}}%
  \endgroup}

%============================================================================
%  4. TITRE DE CHAPITRE   \chapitre{numéro}{Titre}
%============================================================================
% Le numéro vient de la page, jamais d'un compteur : c'est le professeur qui
% numérote ses chapitres, pas Plume. Sans numéro lu, on n'en invente pas.
\newcommand{\chapitre}[2]{%
  \par\vspace{0.4\baselineskip}\noindent
  \begin{tcolorbox}[hbox, enhanced, colback=white, colframe=mcChapitre,
      boxrule=0.9pt, sharp corners, left=10pt, right=10pt, top=6pt, bottom=6pt]
    \large\bfseries\color{mcChapitre}%
    \mcul{mcChapitre}{Chapitre\ifblank{#1}{}{~#1}~:}\ #2
  \end{tcolorbox}
  \par\vspace{0.9\baselineskip}}

%============================================================================
%  5. PARTIES / SOUS-PARTIES  \partie{numéro}{Titre}, etc.
%============================================================================
% Les compteurs LaTeX sont écartés au profit du numéro lu sur la page. Les
% commandes étoilées gardent la mise en forme et l'espacement sans numéroter.
\titleformat{\section}      {\normalfont\large\bfseries}{}{0pt}{}
\titleformat{\subsection}   {\normalfont\normalsize\bfseries}{}{0pt}{}
\titleformat{\subsubsection}{\normalfont\normalsize\itshape}{}{0pt}{}

\newcommand{\partie}[2]{%
  \section*{\mcul{mcPartie}{\ifblank{#1}{#2}{#1 -- #2}}}}
\newcommand{\souspartie}[2]{%
  \subsection*{\mcul{mcSousPartie}{\ifblank{#1}{#2}{#1 -- #2}}}}
\newcommand{\paragraphe}[2]{%
  \subsubsection*{\mcul{mcParagraphe}{\ifblank{#1}{#2}{#1) #2}}}}

\titlespacing*{\section}      {0pt}   {1.3\baselineskip}{0.7\baselineskip}
\titlespacing*{\subsection}   {1cm}   {1.0\baselineskip}{0.5\baselineskip}
\titlespacing*{\subsubsection}{1.8cm} {0.8\baselineskip}{0.4\baselineskip}

%============================================================================
%  6. LE "CROCHET OUVERT" (trait vertical + retour horizontal en bas)
%============================================================================
\newcommand{\mcCrochetComplet}[1]{%
  \draw[line width=0.9pt, color=#1, line cap=round]
    ([xshift=2pt]frame.north west) -- ([xshift=2pt]frame.south west)
    -- ([xshift=16mm]frame.south west);}
\newcommand{\mcCrochetVertical}[1]{%
  \draw[line width=0.9pt, color=#1, line cap=round]
    ([xshift=2pt]frame.north west) -- ([xshift=2pt]frame.south west);}

\newtcolorbox{mccrochet}[1]{%
  enhanced, breakable,
  colback=white, colframe=white, boxrule=0pt, sharp corners,
  frame hidden, interior hidden,
  left=8pt, right=2pt, top=2pt, bottom=10pt,
  grow to left by=8pt,
  before skip=0.6\baselineskip, after skip=0.7\baselineskip,
  overlay unbroken={\mcCrochetComplet{#1}},
  overlay first    ={\mcCrochetVertical{#1}},
  overlay middle   ={\mcCrochetVertical{#1}},
  overlay last     ={\mcCrochetComplet{#1}}}

%============================================================================
%  7. ETIQUETTE D'ENVIRONNEMENT   \mclabel{couleur}{Mot}{titre optionnel}
%============================================================================
\newcommand{\mclabel}[3]{%
  \mcul{#1}{\bfseries #2\ifblank{#3}{}{ (#3)}}%
  \textcolor{#1}{\bfseries\,:}\hspace{0.7em}\ignorespaces}

%============================================================================
%  8. ENVIRONNEMENTS AVEC CROCHET
%     \begin{definition}[titre facultatif] ... \end{definition}
%============================================================================
\newenvironment{definition}[1][]%
  {\begin{mccrochet}{mcDef}\mclabel{mcDef}{{{label.definition}}}{#1}}%
  {\end{mccrochet}}

\newenvironment{propriete}[1][]%
  {\begin{mccrochet}{mcProp}\mclabel{mcProp}{{{label.property}}}{#1}}%
  {\end{mccrochet}}

\newenvironment{theoreme}[1][]%
  {\begin{mccrochet}{mcTheo}\mclabel{mcTheo}{{{label.theorem}}}{#1}}%
  {\end{mccrochet}}

\newenvironment{methode}[1][]%
  {\begin{mccrochet}{mcMethode}\mclabel{mcMethode}{{{label.method}}}{#1}}%
  {\end{mccrochet}}

%============================================================================
%  9. ENVIRONNEMENTS SANS CROCHET (texte courant precede d'une etiquette)
%============================================================================
\newenvironment{mcplain}[3]%
  {\par\vspace{0.35\baselineskip}\noindent\mclabel{#1}{#2}{#3}}%
  {\par\vspace{0.35\baselineskip}}

\newenvironment{exemple}[1][]    {\begin{mcplain}{mcExemple}{{{label.example}}}{#1}}    {\end{mcplain}}
\newenvironment{application}[1][]{\begin{mcplain}{mcApp}{{{label.application}}}{#1}}    {\end{mcplain}}
\newenvironment{remarque}[1][]   {\begin{mcplain}{mcRemarque}{{{label.remark}}}{#1}}  {\end{mcplain}}
\newenvironment{demonstration}[1][]%
  {\begin{mcplain}{mcDemo}{{{label.proof}}}{#1}}%
  {\hfill\textcolor{mcDemo}{$\blacksquare$}\end{mcplain}}

