{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Plume",
  "version": "0.1.1",
  "identifier": "app.plume.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Plume",
        "width": 1100,
        "height": 760,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/Documents/Plume/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app",
      "nsis",
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Education",
    "copyright": "© 2026 Plume",
    "shortDescription": "Vos cours manuscrits, en LaTeX",
    "longDescription": "Plume lit les photos de vos cours de maths écrits à la main et les réécrit dans votre propre charte LaTeX, prêts à relire et à exporter en PDF.",
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/ClementVandvl/plume/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERFQjU3NjEzRUE1QjkyNjYKUldSbWtsdnFFM2ExM25wam1vNjdWR1RvQXZzM3p5eDlxd3prdzFyTlNyUWRzTEJBSUR0SHB1TWYK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}